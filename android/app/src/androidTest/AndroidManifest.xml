            android:authorities="io.mirelay.android.test.fixtures"
            android:exported="true" android:grantUriPermissions="true" />
        <provider android:name="io.mirelay.android.AutoFixtureProvider"
            android:authorities="io.mirelay.android.test.auto" android:exported="true"
            android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
