[Unit]
Description=MiRelay HTTPS reverse proxy
Wants=network-online.target mirelay-server.service
After=network-online.target mirelay-server.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
User=mirelay-proxy
Group=mirelay-proxy
UMask=0077
StateDirectory=mirelay-proxy
StateDirectoryMode=0700
RuntimeDirectory=mirelay-proxy
RuntimeDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/mirelay-proxy
Environment=XDG_CONFIG_HOME=/var/lib/mirelay-proxy
Environment=GOMEMLIMIT=128MiB
ExecStart=/opt/mirelay/bin/caddy run --config /etc/mirelay/Caddyfile --adapter caddyfile
ExecReload=/opt/mirelay/bin/caddy reload --config /etc/mirelay/Caddyfile --adapter caddyfile --address unix//run/mirelay-proxy/admin.sock
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryHigh=192M
MemoryMax=256M
TasksMax=128
CPUWeight=50
IOWeight=50

[Install]
WantedBy=multi-user.target
